{
    "name": "nhwin/momo-payment",
    "description": "Plugin thanh toán MoMo v2 cho Laravel 13 và Filament 5.",
    "type": "library",
    "license": "MIT",
    "keywords": ["momo", "payment", "laravel", "filament", "sandbox"],
    "homepage": "https://github.com/nhwin304/momo-payment",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "nhwin/settings": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nhwin\\MoMoPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nhwin\\MoMoPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nhwin\\MoMoPayment\\MoMoPaymentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": ["@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
